# Copy this file to .env and fill in real values before running the server.
# Never commit the real .env file to version control.

# Long, random string used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API server listens on.
PORT=4000

# Where the SQLite database file is stored. Defaults to server/samamiable.db if unset.
DATABASE_PATH=

# Comma-free single origin allowed to call this API (your website's real domain).
# Use * only during local development.
CORS_ORIGIN=*

# Used once by `npm run seed` to create the single admin account.
ADMIN_EMAIL=admin@samamiableconstruction.com
ADMIN_PASSWORD=ChangeThisPassword123!
